{
  "buildCommand": "npm --workspace=client run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/__clerk/:path*",
      "destination": "https://trusty-slug-321.clerk.accounts.dev/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

