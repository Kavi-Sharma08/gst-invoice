# BillGST Email Worker Environment Variables
# Copy this file to .env and configure real credentials for production.

NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/billgst
POLL_INTERVAL_MS=10000
JOB_LEASE_DURATION_MS=60000
MAX_CONCURRENT_JOBS=3

# Email sender configuration
EMAIL_FROM_ADDRESS=noreply@billgst.in
EMAIL_FROM_NAME=BillGST

# SMTP Configuration
# In development, leave these blank to generate an Ethereal test inbox link automatically.
# In production, specify your SMTP provider (e.g. SendGrid, Amazon SES, Resend, Brevo).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password
SMTP_SECURE=false
