# BillGST Server Environment Variables
# Copy this file to .env and fill in real values before starting the server.

# Server
NODE_ENV=development
PORT=5000

# MongoDB — replace with your MongoDB Atlas connection string for production
MONGODB_URI=mongodb://127.0.0.1:27017/billgst

# Clerk Authentication Keys (From Clerk Dashboard: https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_replace_with_your_clerk_key
CLERK_SECRET_KEY=sk_test_placeholder_replace_with_your_clerk_secret

# CORS — set to your Vercel frontend URL in production (e.g. https://gst-invoice-brown.vercel.app)
CORS_ORIGIN=http://localhost:5173
